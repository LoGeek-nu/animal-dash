{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "animaldash",
  "account_id": "bd6022bab607c76f306d3a313431d8f6",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "animaldash.logeek.tech",
      "custom_domain": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "CHARACTERS",
      "bucket_name": "animaldash-characters"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
