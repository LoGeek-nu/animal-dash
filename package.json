{
  "name": "animal-dash",
  "version": "0.5.5",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "postbuild": "node scripts/remove-generated-types.js",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start",
    "deploy": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext-cloudflare deploy --config dist/server/wrangler.json && node scripts/remove-generated-types.js",
    "deploy:dry-run": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext-cloudflare deploy --dry-run",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@vinext/cloudflare": "1.0.0-beta.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "10.1.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
